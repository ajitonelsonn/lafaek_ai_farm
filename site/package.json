{
  "name": "lafaek-ai-farm-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for Lafaek AI Farm. Renders the project's own Markdown, synced from the repository.",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "npm run sync && vite",
