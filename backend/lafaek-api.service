[Unit]
Description=Lafaek AI Farm online re-analysis API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/lafaek-backend
EnvironmentFile=/home/ubuntu/lafaek-backend/.env
ExecStart=/home/ubuntu/lafaek-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
